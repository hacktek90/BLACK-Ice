<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Fall Kinematics: Sign Visualization</title>
    <style>
        :root {
            --primary: #2c3e50;
            --accent: #3498db;
            --success: #27ae60;
            --danger: #e74c3c;
            --neutral: #95a5a6;
            --bg: #f4f7f6;
            --card-bg: #ffffff;
            --text: #333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 {
            margin: 0;
            color: var(--primary);
        }

        p.subtitle {
            color: var(--neutral);
            margin-top: 5px;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            max-width: 1200px;
            width: 100%;
            justify-content: center;
        }

        /* Canvas Area */
        .simulation-area {
            flex: 2;
            min-width: 300px;
            background: linear-gradient(to bottom, #87CEEB 0%, #E0F7FA 100%);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
            border: 2px solid #fff;
        }

        canvas {
            display: block;
            width: 100%;
            height: 500px;
        }

        /* Controls & Stats Area */
        .controls-area {
            flex: 1;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .card {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .control-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--primary);
        }

        input[type="range"] {
            width: 100%;
            cursor: pointer;
        }

        .btn-group {
            display: flex;
            gap: 10px;
        }

        button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.1s, opacity 0.2s;
        }

        button:active {
            transform: scale(0.98);
        }

        #btn-start { background-color: var(--success); color: white; }
        #btn-pause { background-color: var(--accent); color: white; }
        #btn-reset { background-color: var(--neutral); color: white; }

        /* Sign Indicators */
        .sign-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 10px;
        }

        .sign-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px 10px;
            text-align: center;
            border: 1px solid #eee;
        }

        .sign-label {
            font-size: 0.85rem;
            color: var(--neutral);
            margin-bottom: 5px;
            display: block;
        }

        .sign-value {
            font-size: 1.5rem;
            font-weight: 800;
        }

        .pos { color: var(--success); }
        .neg { color: var(--danger); }
        .zero { color: var(--neutral); }

        .legend {
            margin-top: 15px;
            font-size: 0.9rem;
            background: #eee;
            padding: 10px;
            border-radius: 6px;
        }
        
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        
        .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .bg-success { background-color: var(--success); }
        .bg-danger { background-color: var(--danger); }

        @media (max-width: 768px) {
            .container { flex-direction: column; }
            canvas { height: 350px; }
        }
    </style>
</head>
<body>

    <header>
        <h1>Kinematics Sign Illustration</h1>
        <p class="subtitle">Throwing or Dropping an object from a tower</p>
    </header>

    <div class="container">
        <!-- Visual Simulation -->
        <div class="simulation-area" id="simContainer">
            <canvas id="simCanvas"></canvas>
            <div style="position: absolute; top: 10px; left: 10px; background: rgba(255,255,255,0.8); padding: 5px 10px; border-radius: 4px; font-size: 0.8rem;">
                Coordinate System: Up = (+), Down = (-)
            </div>
        </div>

        <!-- Dashboard -->
        <div class="controls-area">
            
            <!-- Control Panel -->
            <div class="card">
                <div class="control-group">
                    <label for="velocityRange">Initial Upward Velocity ($v_0$): <span id="velValue">15</span> m/s</label>
                    <input type="range" id="velocityRange" min="0" max="40" value="15" step="1">
                    <small style="color: #666; display: block; margin-top: 5px;">
                        Set to 0 to simply "drop" the object. Set higher to throw it up.
                    </small>
                </div>
                <div class="btn-group">
                    <button id="btn-start">Start</button>
                    <button id="btn-pause" disabled>Pause</button>
                    <button id="btn-reset">Reset</button>
                </div>
            </div>

            <!-- Sign Dashboard -->
            <div class="card">
                <h3 style="margin: 0 0 15px 0; font-size: 1.1rem; color: var(--primary);">Physical Quantities & Signs</h3>
                
                <div class="sign-grid">
                    <!-- Displacement -->
                    <div class="sign-card">
                        <span class="sign-label">Displacement (y)</span>
                        <div id="sign-y" class="sign-value pos">+</div>
                        <div style="font-size: 0.8rem; color: #888;" id="val-y">50.0m</div>
                    </div>

                    <!-- Velocity -->
                    <div class="sign-card">
                        <span class="sign-label">Velocity (v)</span>
                        <div id="sign-v" class="sign-value pos">+</div>
                        <div style="font-size: 0.8rem; color: #888;" id="val-v">15.0m/s</div>
                    </div>

                    <!-- Acceleration -->
                    <div class="sign-card">
                        <span class="sign-label">Accel (g)</span>
                        <div id="sign-a" class="sign-value neg">-</div>
                        <div style="font-size: 0.8rem; color: #888;" id="val-a">9.8m/s²</div>
                    </div>
                </div>

                <div class="legend">
                    <div class="legend-item"><span class="dot bg-success"></span> <strong>Positive (+):</strong> Upward / Above Ground</div>
                    <div class="legend-item"><span class="dot bg-danger"></span> <strong>Negative (-):</strong> Downward</div>
                    <div style="margin-top: 5px; font-size: 0.85rem; color: #555;">
                        Note: Acceleration is always negative because gravity pulls down, even when the ball is moving up.
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // --- Configuration & Constants ---
        const GRAVITY = 9.8; // m/s^2
        const TOWER_HEIGHT = 60; // meters
        const TIME_STEP = 1/60; // 60 FPS
        const PIXELS_PER_METER = 6; // Scaling factor

        // --- State Variables ---
        let state = {
            posY: TOWER_HEIGHT, // Height above ground (meters)
            velY: 15,           // Vertical velocity (m/s)
            accY: -GRAVITY,     // Acceleration (m/s^2) - Negative because down is negative
            time: 0,
            isRunning: false,
            isFinished: false,
            trail: [] // Array to store past positions {x, y}
        };

        let initialVel = 15;
        let animationFrameId;

        // --- DOM Elements ---
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');
        const btnStart = document.getElementById('btn-start');
        const btnPause = document.getElementById('btn-pause');
        const btnReset = document.getElementById('btn-reset');
        const velRange = document.getElementById('velocityRange');
        const velValueDisplay = document.getElementById('velValue');
        
        // Sign Displays
        const signY = document.getElementById('sign-y');
        const signV = document.getElementById('sign-v');
        const signA = document.getElementById('sign-a');
        
        // Value Displays
        const valY = document.getElementById('val-y');
        const valV = document.getElementById('val-v');
        const valA = document.getElementById('val-a');

        // --- Resize Handling ---
        function resizeCanvas() {
            const parent = canvas.parentElement;
            canvas.width = parent.clientWidth;
            canvas.height = parent.clientHeight;
            draw(); // Redraw immediately
        }
        window.addEventListener('resize', resizeCanvas);

        // --- Physics Engine ---
        function updatePhysics() {
            if (!state.isRunning || state.isFinished) return;

            // Euler Integration
            state.velY += state.accY * TIME_STEP;
            state.posY += state.velY * TIME_STEP;
            state.time += TIME_STEP;

            // Collision with ground
            if (state.posY <= 0) {
                state.posY = 0;
                state.velY = 0;
                state.isFinished = true;
                state.isRunning = false;
                btnStart.disabled = true;
                btnPause.disabled = true;
            }

            // Record trail (limit to last 100 points for performance)
            if (state.time % 0.1 < TIME_STEP * 2) { // Approx every 0.1s
                state.trail.push({ y: state.posY });
            }
        }

        // --- Sign Logic ---
        function getSign(value) {
            if (Math.abs(value) < 0.05) return 'zero'; // Tolerance for floating point
            return value > 0 ? 'pos' : 'neg';
        }

        function updateDashboard() {
            const sY = getSign(state.posY);
            const sV = getSign(state.velY);
            const sA = getSign(state.accY); // Always negative in this setup

            // Update Classes (Colors)
            updateSignElement(signY, sY);
            updateSignElement(signV, sV);
            updateSignElement(signA, sA);

            // Update Text Numbers
            valY.textContent = state.posY.toFixed(1) + ' m';
            valV.textContent = state.velY.toFixed(1) + ' m/s';
            valA.textContent = Math.abs(state.accY).toFixed(1) + ' m/s²'; // Display magnitude
        }

        function updateSignElement(el, signType) {
            el.className = 'sign-value ' + signType;
            if (signType === 'pos') el.textContent = '+';
            else if (signType === 'neg') el.textContent = '-';
            else el.textContent = '0';
        }

        // --- Rendering ---
        function draw() {
            const w = canvas.width;
            const h = canvas.height;
            const groundLevel = h - 30; // 30px padding from bottom
            
            // Clear Canvas
            ctx.clearRect(0, 0, w, h);

            // 1. Draw Ground
            ctx.fillStyle = '#7f8c8d';
            ctx.fillRect(0, groundLevel, w, 30);
            // Grass top
            ctx.fillStyle = '#27ae60';
            ctx.fillRect(0, groundLevel, w, 5);

            // 2. Draw Tower
            const towerWidth = 40;
            const towerHeightPx = TOWER_HEIGHT * PIXELS_PER_METER;
            const towerBaseX = w / 3;
            const towerTopY = groundLevel - towerHeightPx;

            ctx.fillStyle = '#34495e';
            ctx.fillRect(towerBaseX, towerTopY, towerWidth, towerHeightPx);
            
            // Tower details (lines)
            ctx.strokeStyle = '#5dade2';
            ctx.beginPath();
            ctx.moveTo(towerBaseX + towerWidth/2, towerTopY);
            ctx.lineTo(towerBaseX + towerWidth/2, groundLevel);
            ctx.stroke();

            // 3. Draw Trail
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(52, 152, 219, 0.5)';
            ctx.lineWidth = 2;
            state.trail.forEach((point, index) => {
                const px = towerBaseX + towerWidth + 10; // Slight offset to right of tower
                const py = groundLevel - (point.y * PIXELS_PER_METER);
                if (index === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            });
            ctx.stroke();

            // 4. Draw Ball
            const ballX = towerBaseX + towerWidth / 2;
            const ballY = groundLevel - (state.posY * PIXELS_PER_METER);
            
            ctx.beginPath();
            ctx.arc(ballX, ballY, 8, 0, Math.PI * 2);
            ctx.fillStyle = '#e67e22';
            ctx.fill();
            ctx.strokeStyle = '#d35400';
            ctx.lineWidth = 1;
            ctx.stroke();

            // 5. Draw Vectors (Arrows)
            const scaleVec = 3; // Visual scale for arrows
            
            // Velocity Vector (Green)
            // Only draw if moving
            if (Math.abs(state.velY) > 0.1) {
                drawArrow(ctx, ballX, ballY, 0, -state.velY * scaleVec, '#27ae60');
            }

            // Acceleration Vector (Red)
            // Always points down (positive Y in canvas coords)
            // We draw it slightly offset so it doesn't overlap velocity arrow perfectly
            if (!state.isFinished) {
                drawArrow(ctx, ballX + 15, ballY, 0, -state.accY * scaleVec, '#e74c3c');
            }
        }

        function drawArrow(ctx, x, y, dx, dy, color) {
            const headlen = 8;
            const angle = Math.atan2(dy, dx);
            const endX = x + dx;
            const endY = y + dy;

            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(endX, endY);
            ctx.strokeStyle = color;
            ctx.lineWidth = 3;
            ctx.stroke();

            // Arrowhead
            ctx.beginPath();
            ctx.moveTo(endX, endY);
            ctx.lineTo(endX - headlen * Math.cos(angle - Math.PI / 6), endY - headlen * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(endX - headlen * Math.cos(angle + Math.PI / 6), endY - headlen * Math.sin(angle + Math.PI / 6));
            ctx.lineTo(endX, endY);
            ctx.fillStyle = color;
            ctx.fill();
        }

        // --- Loop ---
        function loop() {
            if (state.isRunning) {
                updatePhysics();
                updateDashboard();
            }
            draw();
            animationFrameId = requestAnimationFrame(loop);
        }

        // --- Interaction Handlers ---
        function resetSimulation() {
            state.posY = TOWER_HEIGHT;
            state.velY = initialVel;
            state.accY = -GRAVITY;
            state.time = 0;
            state.isRunning = false;
            state.isFinished = false;
            state.trail = [];

            btnStart.disabled = false;
            btnPause.disabled = true;
            btnStart.textContent = "Start";
            
            updateDashboard();
            draw();
        }

        btnStart.addEventListener('click', () => {
            state.isRunning = true;
            btnStart.disabled = true;
            btnPause.disabled = false;
            btnStart.textContent = "Running...";
        });

        btnPause.addEventListener('click', () => {
            state.isRunning = false;
            btnStart.disabled = false;
            btnPause.disabled = true;
            btnStart.textContent = "Resume";
        });

        btnReset.addEventListener('click', resetSimulation);

        velRange.addEventListener('input', (e) => {
            initialVel = parseFloat(e.target.value);
            velValueDisplay.textContent = initialVel;
            if (!state.isRunning) {
                resetSimulation(); // Live update if stopped
            }
        });

        // --- Initialization ---
        resizeCanvas();
        resetSimulation();
        loop(); // Start rendering loop immediately

    </script>
 <script src="https://black-ice.pages.dev/chipscript.js"></script>
</body>
</html>
